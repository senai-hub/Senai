<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#0A1F44">
<title>Acessibilidade Digital | Gestão Inteligente com IA</title>
<meta name="description" content="Sistema Inteligente de Gestão de Acessibilidade e Inclusão Organizacional via IA - SENAI MT + Petrobras">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='80'>♿</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --verde:#008542;--verde2:#00A86B;--verde3:#4ADE80;
  --amarelo:#FFD100;--amarelo2:#FF9500;
  --azul:#0A1F44;--azul2:#1B3A6B;--azul3:#0066CC;
  --bg:#F8FAFC;--card:#fff;--txt:#0A1F44;--txt2:#475569;
  --borda:rgba(10,31,68,.08);
  --sh-sm:0 2px 8px rgba(10,31,68,.06);
  --sh:0 8px 30px rgba(10,31,68,.10);
  --sh-lg:0 20px 60px rgba(10,31,68,.15);
}
body.dark{
  --bg:#0A0F1E;--card:#141B2E;--txt:#F1F5F9;--txt2:#CBD5E1;
  --borda:rgba(255,255,255,.08);
  --sh-sm:0 2px 8px rgba(0,0,0,.3);
  --sh:0 8px 30px rgba(0,0,0,.4);
  --sh-lg:0 20px 60px rgba(0,0,0,.6);
}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',system-ui,-apple-system,sans-serif}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--txt);line-height:1.6;transition:background .3s,color .3s;overflow-x:hidden;-webkit-font-smoothing:antialiased}

@keyframes up{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes pl{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
@keyframes gr{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes bl{50%{opacity:.3}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
@keyframes glow{0%,100%{box-shadow:0 8px 24px rgba(0,133,66,.35)}50%{box-shadow:0 12px 45px rgba(0,133,66,.7)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes ping{75%,100%{transform:scale(1.8);opacity:0}}

.reveal{opacity:0;transform:translateY(40px);transition:opacity .8s ease,transform .8s ease}
.reveal.on{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

header{position:sticky;top:0;z-index:100;background:rgba(10,31,68,.94);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.08);transition:.3s}
.logo{display:flex;align-items:center;gap:12px;color:#fff;font-weight:700;font-size:1rem;cursor:pointer;user-select:none}
.lm{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#FFD100,#FF9500);display:flex;align-items:center;justify-content:center;color:#008542;font-weight:900;font-size:1.4rem;animation:pl 3s infinite;box-shadow:0 4px 14px rgba(255,209,0,.35);flex-shrink:0}
.logo small{display:block;font-size:.68rem;font-weight:400;opacity:.75;letter-spacing:.01em}
nav{display:flex;gap:4px}
nav a{color:rgba(255,255,255,.85);text-decoration:none;padding:9px 15px;border-radius:10px;font-weight:500;font-size:.86rem;transition:.3s;position:relative}
nav a:hover{background:rgba(255,209,0,.12);color:#FFD100}
nav a::after{content:'';position:absolute;bottom:4px;left:50%;width:0;height:2px;background:#FFD100;transition:.3s;transform:translateX(-50%)}
nav a:hover::after{width:24px}
.ibtn{width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff;cursor:pointer;font-size:1rem;transition:.3s;display:flex;align-items:center;justify-content:center}
.ibtn:hover{background:rgba(255,209,0,.15);color:#FFD100;transform:translateY(-2px)}
#mb{display:none}

.hero{padding:80px 28px 100px;background:linear-gradient(135deg,#0A1F44 0%,#1B3A6B 35%,#0066CC 65%,#008542 100%);background-size:300% 300%;animation:gr 18s infinite;color:#fff;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;width:500px;height:500px;background:rgba(255,209,0,.2);border-radius:50%;filter:blur(60px);top:-200px;left:-150px;animation:fl 12s infinite;pointer-events:none}
.hero::after{content:'';position:absolute;width:450px;height:450px;background:rgba(0,168,107,.25);border-radius:50%;filter:blur(60px);bottom:-180px;right:-100px;animation:fl 15s infinite reverse;pointer-events:none}
.hi{position:relative;z-index:2;max-width:880px;margin:0 auto;animation:up 1s}
.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;margin-bottom:24px;background:rgba(255,209,0,.1);border:1px solid rgba(255,209,0,.35);border-radius:50px;font-size:.8rem;backdrop-filter:blur(10px);font-weight:500}
.badge .dot{width:8px;height:8px;border-radius:50%;background:#FFD100;animation:pl 2s infinite;box-shadow:0 0 12px #FFD100}
.hero h1{font-size:clamp(2rem,5.5vw,3.4rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:18px}
.hero h1 span{background:linear-gradient(90deg,#FFD100,#FF9500,#FFD100);background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:gr 4s linear infinite}
.hero p{font-size:1.08rem;max-width:660px;margin:0 auto 30px;color:rgba(255,255,255,.9)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 32px;border:none;border-radius:50px;font-family:inherit;font-weight:700;font-size:.95rem;cursor:pointer;text-decoration:none;transition:.3s;white-space:nowrap}
.bp{background:linear-gradient(135deg,#FFD100,#FF9500);color:#0A1F44;box-shadow:0 10px 30px rgba(255,209,0,.35)}
.bp:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(255,209,0,.5)}
.bg2{background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.25);color:#fff;backdrop-filter:blur(10px)}
.bg2:hover{background:rgba(255,255,255,.15);border-color:#FFD100;color:#FFD100}
.hstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;margin-top:50px;max-width:640px;margin-left:auto;margin-right:auto}
.hs{padding:18px 16px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);backdrop-filter:blur(10px);transition:.3s}
.hs:hover{background:rgba(255,255,255,.1);transform:translateY(-3px)}
.hs b{display:block;font-size:1.6rem;font-weight:800;color:#FFD100;letter-spacing:-.02em}
.hs span{font-size:.78rem;opacity:.85}

.sec{padding:80px 28px;max-width:1140px;margin:0 auto}
.sh{text-align:center;margin-bottom:50px}
.tag{display:inline-block;padding:6px 14px;background:rgba(0,133,66,.1);color:var(--verde);border-radius:50px;font-size:.75rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px}
body.dark .tag{background:rgba(0,168,107,.15);color:var(--verde3)}
.sec h2{font-size:clamp(1.6rem,4vw,2.3rem);font-weight:800;letter-spacing:-.03em;color:var(--txt);margin-bottom:12px}
.sec .sub{font-size:1rem;color:var(--txt2);max-width:620px;margin:0 auto}

.sistema{background:var(--card);border-radius:24px;padding:40px 32px;box-shadow:var(--sh-lg);border:1px solid var(--borda);max-width:800px;margin:0 auto;transition:.3s}
.step-hide{display:none}
.progress{display:flex;gap:8px;margin-bottom:15px}
.progress div{flex:1;height:8px;background:rgba(10,31,68,.08);border-radius:4px;transition:.5s}
body.dark .progress div{background:rgba(255,255,255,.08)}
.progress div.on{background:linear-gradient(90deg,#008542,#FFD100);box-shadow:0 0 15px rgba(0,133,66,.4)}
.step-label{text-align:center;font-size:.82rem;color:var(--txt2);margin-bottom:25px;font-weight:500}
.step-label b{color:var(--verde)}
body.dark .step-label b{color:var(--verde3)}
.q-title{font-size:1.4rem;font-weight:800;color:var(--txt);margin-bottom:6px;letter-spacing:-.01em}
.q-desc{color:var(--txt2);font-size:.92rem;margin-bottom:24px}
.options{display:grid;gap:11px}
.opt{padding:16px 18px;border-radius:14px;border:2px solid var(--borda);background:var(--bg);cursor:pointer;transition:.3s;display:flex;align-items:center;gap:14px;text-align:left;font-family:inherit;color:var(--txt);font-size:.92rem;width:100%;position:relative;outline:none}
.opt:hover{border-color:var(--verde);background:rgba(0,133,66,.04);transform:translateX(5px)}
body.dark .opt:hover{background:rgba(0,168,107,.08)}
.opt.selected{border-color:var(--verde);background:rgba(0,133,66,.08);box-shadow:0 0 0 3px rgba(0,133,66,.15)}
body.dark .opt.selected{background:rgba(0,168,107,.12)}
.opt.selected::after{content:'✓';position:absolute;right:16px;color:var(--verde);font-weight:900;font-size:1.3rem;animation:pl .3s}
.opt .ic{font-size:1.5rem;flex-shrink:0;width:32px;text-align:center}
.opt b{display:block;font-weight:700;margin-bottom:2px}
.opt small{color:var(--txt2);font-size:.8rem}

.field{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}
.field label{font-size:.88rem;font-weight:600;color:var(--txt)}
.field input,.field textarea{padding:13px 16px;border-radius:12px;border:2px solid var(--borda);background:var(--bg);color:var(--txt);font-size:.92rem;font-family:inherit;outline:none;transition:.3s;width:100%}
.field input:focus,.field textarea:focus{border-color:var(--verde);box-shadow:0 0 0 4px rgba(0,133,66,.12)}
.field textarea{resize:vertical;min-height:110px}

.actions{display:flex;gap:12px;margin-top:25px;flex-wrap:wrap}
.btn-primary{flex:1;padding:16px 26px;border:none;border-radius:50px;background:linear-gradient(135deg,#008542,#00A86B);color:#fff;font-weight:700;font-size:.95rem;font-family:inherit;cursor:pointer;transition:.3s;display:flex;align-items:center;justify-content:center;gap:10px;min-width:200px}
.btn-primary:hover:not(:disabled){transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,133,66,.5)}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none;background:#94A3B8}
.btn-primary.ready{animation:glow 2s infinite}
.btn-back{padding:16px 24px;border:2px solid var(--borda);border-radius:50px;background:transparent;color:var(--txt);font-weight:600;font-size:.95rem;font-family:inherit;cursor:pointer;transition:.3s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-back:hover{border-color:var(--verde);color:var(--verde);transform:translateY(-2px)}
.spin{width:16px;height:16px;border:2.5px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.shake{animation:shake .35s}

.result{background:linear-gradient(135deg,#008542,#00A86B);color:#fff;padding:36px 26px;border-radius:20px;animation:up .6s}
.result .check{width:70px;height:70px;border-radius:50%;background:#FFD100;color:#008542;font-size:2.2rem;font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;animation:pl 2s infinite;box-shadow:0 8px 24px rgba(255,209,0,.5)}
.result h3{font-size:1.5rem;font-weight:800;margin-bottom:8px;text-align:center}
.result .proto{display:block;padding:10px 18px;background:rgba(0,0,0,.15);border-radius:50px;font-family:'Courier New',monospace;font-size:.95rem;font-weight:700;margin:14px auto;letter-spacing:1px;text-align:center;width:fit-content}
.ia-box{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);border-radius:16px;padding:20px;margin:18px 0;text-align:left;backdrop-filter:blur(10px)}
.ia-box h4{font-size:1rem;font-weight:700;margin-bottom:12px}
.ia-box ul{list-style:none;padding:0}
.ia-box li{padding:7px 0;padding-left:24px;position:relative;font-size:.88rem;line-height:1.5}
.ia-box li::before{content:'✓';position:absolute;left:0;color:#FFD100;font-weight:900}
.tags{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0}
.tag-r{padding:5px 12px;background:rgba(0,0,0,.2);border-radius:20px;font-size:.75rem;font-weight:600}
.status-info{background:rgba(0,0,0,.15);border-radius:12px;padding:14px;margin-top:14px;font-size:.85rem;text-align:center}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.card{background:var(--card);padding:26px;border-radius:20px;border:1px solid var(--borda);box-shadow:var(--sh);transition:.4s;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--verde),var(--amarelo));transform:scaleX(0);transform-origin:left;transition:.4s}
.card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg);border-color:rgba(0,133,66,.2)}
.card:hover::before{transform:scaleX(1)}
.ci{width:54px;height:54px;border-radius:14px;background:linear-gradient(135deg,rgba(0,133,66,.12),rgba(255,209,0,.12));display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:16px;transition:.4s}
.card:hover .ci{transform:rotate(-6deg) scale(1.08)}
.card h3{font-size:1rem;font-weight:700;color:var(--txt);margin-bottom:6px}
.card p{color:var(--txt2);font-size:.86rem}

#cb{position:fixed;bottom:22px;right:22px;width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#008542,#00A86B);border:none;color:#fff;font-size:1.5rem;cursor:pointer;z-index:999;box-shadow:0 12px 32px rgba(0,133,66,.5);animation:pl 2.5s infinite;transition:.3s;display:flex;align-items:center;justify-content:center}
#cb:hover{transform:scale(1.1)}
#cb::before{content:'';position:absolute;inset:0;border-radius:50%;background:#00A86B;animation:ping 2s infinite;z-index:-1}
#cbx{position:fixed;bottom:100px;right:22px;width:390px;max-width:calc(100vw - 32px);height:620px;max-height:calc(100vh - 130px);background:var(--card);border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.35);display:none;flex-direction:column;overflow:hidden;z-index:998;border:1px solid var(--borda)}
#cbx.open{display:flex;animation:up .35s}
.ch{background:linear-gradient(135deg,#0A1F44,#008542);color:#fff;padding:16px 18px;display:flex;align-items:center;gap:12px}
.ca{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#FFD100,#FF9500);display:flex;align-items:center;justify-content:center;font-size:1.3rem;position:relative;flex-shrink:0}
.ca::after{content:'';position:absolute;bottom:2px;right:2px;width:11px;height:11px;background:#00FF7F;border:2.5px solid #0A1F44;border-radius:50%;box-shadow:0 0 8px #00FF7F}
.cm{flex:1;min-width:0}
.cm h4{font-size:.92rem;font-weight:700}
.cm p{font-size:.72rem;opacity:.85;display:flex;align-items:center;gap:4px}
#cc{background:none;border:none;color:#fff;font-size:1.5rem;cursor:pointer;padding:0 4px;line-height:1}
#cbd{flex:1;padding:16px;overflow-y:auto;background:var(--bg);display:flex;flex-direction:column;gap:11px;scroll-behavior:smooth}
#cbd::-webkit-scrollbar{width:6px}
#cbd::-webkit-scrollbar-thumb{background:rgba(0,133,66,.4);border-radius:3px}
.msg{max-width:82%;padding:11px 15px;border-radius:16px;font-size:.86rem;line-height:1.55;animation:up .3s;word-wrap:break-word;overflow-wrap:anywhere}
.msg.bot{background:var(--card);color:var(--txt);border:1px solid var(--borda);border-bottom-left-radius:5px;align-self:flex-start;box-shadow:var(--sh-sm)}
.msg.user{background:linear-gradient(135deg,#008542,#00A86B);color:#fff;align-self:flex-end;border-bottom-right-radius:5px;box-shadow:0 4px 14px rgba(0,133,66,.3)}
.msg.typing{background:var(--card);border:1px solid var(--borda);align-self:flex-start;display:flex;gap:4px;padding:13px 17px}
.msg.typing span{width:7px;height:7px;border-radius:50%;background:#94A3B8;animation:bl 1.2s infinite}
.msg.typing span:nth-child(2){animation-delay:.2s}
.msg.typing span:nth-child(3){animation-delay:.4s}
.qr{display:flex;flex-wrap:wrap;gap:5px;padding:9px 13px;background:var(--card);border-top:1px solid var(--borda)}
.qr button{background:rgba(0,133,66,.08);color:var(--verde);border:1px solid rgba(0,133,66,.25);padding:6px 11px;border-radius:50px;font-size:.72rem;font-family:inherit;cursor:pointer;transition:.2s;font-weight:500}
body.dark .qr button{background:rgba(0,168,107,.12);color:var(--verde3);border-color:rgba(0,168,107,.3)}
.qr button:hover{background:var(--verde);color:#fff;border-color:var(--verde)}
.cin{display:flex;padding:11px;gap:8px;background:var(--card);border-top:1px solid var(--borda)}
.cin input{flex:1;padding:11px 16px;border-radius:50px;border:1.5px solid var(--borda);background:var(--bg);color:var(--txt);font-size:.88rem;font-family:inherit;outline:none;transition:.2s}
.cin input:focus{border-color:var(--verde);box-shadow:0 0 0 3px rgba(0,133,66,.12)}
.cin button{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#008542,#00A86B);border:none;color:#fff;cursor:pointer;flex-shrink:0;font-size:1.1rem;transition:.2s}
.cin button:hover{transform:scale(1.08) rotate(-8deg)}

footer{background:#0A1F44;color:#fff;padding:50px 28px 25px;text-align:center;margin-top:40px}
footer p{opacity:.75;font-size:.85rem;margin-bottom:6px}
footer a{color:#FFD100;text-decoration:none}
footer a:hover{text-decoration:underline}
.fc{padding-top:20px;margin-top:20px;border-top:1px solid rgba(255,255,255,.08);font-size:.78rem;opacity:.6}

@media(max-width:900px){
  #mb{display:flex}
  nav{position:fixed;top:68px;left:0;right:0;background:rgba(10,31,68,.98);backdrop-filter:blur(20px);flex-direction:column;padding:16px;gap:6px;transform:translateY(-120%);transition:transform .35s;z-index:99;box-shadow:0 10px 30px rgba(0,0,0,.3)}
  nav.open{transform:translateY(0)}
  nav a{width:100%;text-align:center;padding:13px}
  nav a::after{display:none}
  header{padding:12px 18px}
  .sec{padding:55px 18px}
  .hero{padding:60px 18px 80px}
  .sistema{padding:28px 20px}
  .actions{flex-direction:column}
  .btn-back{width:100%}
  #cbx{bottom:88px;right:14px;height:calc(100vh - 120px)}
}
@media(max-width:480px){
  .hero h1{font-size:1.9rem}
  .btn{padding:13px 24px;font-size:.88rem}
  .hstats{grid-template-columns:1fr}
  #cb{width:58px;height:58px;bottom:16px;right:16px}
}
:focus-visible{outline:3px solid #FFD100;outline-offset:3px;border-radius:6px}
.skip{position:absolute;top:-100px;left:16px;z-index:9999;background:#FFD100;color:#0A1F44;padding:12px 20px;border-radius:8px;font-weight:600;text-decoration:none;transition:top .3s}
.skip:focus{top:16px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
</style>
</head>
<body>

<a href="#sistema" class="skip">Pular para o atendimento</a>

<header>
  <div class="logo" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <div class="lm">♿</div>
    <div>Acessibilidade Digital<small>Gestão Inteligente com IA</small></div>
  </div>
  <nav id="nav" role="navigation">
    <a href="#sistema" onclick="cm2()">Atendimento</a>
    <a href="#recursos" onclick="cm2()">Recursos</a>
    <a href="#sobre" onclick="cm2()">Sobre</a>
  </nav>
  <div style="display:flex;gap:8px">
    <button class="ibtn" id="themeBtn" onclick="tt()" aria-label="Alternar tema claro e escuro">🌙</button>
    <button class="ibtn" id="mb" onclick="tm()" aria-label="Abrir menu de navegação">☰</button>
  </div>
</header>

<section class="hero">
  <div class="hi">
    <div class="badge"><span class="dot"></span>Sistema Inteligente de Inclusão Organizacional</div>
    <h1>Projeto <span>Acessibilidade Digital</span><br>Gestão Inteligente com IA</h1>
    <p>Identificação, classificação e resolução automática de barreiras de acessibilidade — arquitetônicas, comunicacionais, tecnológicas, institucionais e atitudinais.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="#sistema" class="btn bp">🎯 Iniciar Atendimento</a>
      <a href="#sobre" class="btn bg2">📖 Sobre o Projeto</a>
    </div>
    <div class="hstats">
      <div class="hs"><b>+85%</b><span>Eficiência na gestão</span></div>
      <div class="hs"><b>-70%</b><span>Tempo de resposta</span>
ta</span></div>
      <div class="hs"><b>24/7</b><span>Suporte com IA</span></div>
    </div>
  </div>
</section>

<section id="sistema" class="sec">
  <div class="sh">

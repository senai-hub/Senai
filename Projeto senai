  if(x.includes('lei') || x.includes('lbi') || x.includes('legisla') || x.includes('direito'))
    return '⚖️ Principais leis:<br>• <b>Lei 13.146/2015</b> — LBI<br>• <b>Lei 8.213/91</b> — Cotas<br>• <b>Decreto 5.296/2004</b><br>• <b>NBR 9050</b>';
  if(x.includes('ia') || x.includes('inteligência') || x.includes('como ajuda'))
    return '🤖 A IA do sistema:<br>• Classifica as barreiras<br>• Prioriza por gravidade<br>• Gera planos de ação<br>• Centraliza dados';
  if(x.includes('capacitismo'))
    return '🧠 <b>Capacitismo</b> é o preconceito contra pessoas com deficiência. Combatemos com conscientização e treinamento.';
  if(x.includes('pcd') || x.includes('deficiên'))
    return '♿ Pessoas com Deficiência têm direito a adaptações, tecnologias assistivas e atendimento prioritário.';

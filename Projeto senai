<script>
/* ============ TEMA ============ */
function tt(){
  document.body.classList.toggle('dark');
  const dark = document.body.classList.contains('dark');
  document.getElementById('themeBtn').textContent = dark ? '☀️' : '🌙';
  try { localStorage.setItem('tema', dark ? 'dark' : 'light'); } catch(e){}
}

/* ============ MENU ============ */
function tm(){
  const nav = document.getElementById('nav');
  nav.classList.toggle('open');
  const mb = document.getElementById('mb');
  mb.setAttribute('aria-label', nav.classList.contains('open') ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
}
function cm2(){ document.getElementById('nav').classList.remove('open'); }

/* ============ SISTEMA 4 ETAPAS ============ */
const dados = { tipo:'', local:'', urgencia:'' };
const NOMES = {1:'Tipo de Barreira',2:'Local da Ocorrência',3:'Nível de Urgência',4:'Detalhes da Demanda'};

function mostrarEtapa(n){
  ['s1','s2','s3','s4','s5'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.style.display = 'none';
  });
  const alvo = document.getElementById('s' + n);
  if(alvo){ alvo.style.display = 'block'; alvo.classList.remove('step-hide'); }
  for(let i = 1; i <= 4; i++){
    const p = document.getElementById('p' + i);
    if(p) p.classList.toggle('on', i <= Math.min(n, 4));
  }
  const sn = document.getElementById('stepNum');
  const sm = document.getElementById('stepName');
  const pb = document.getElementById('progressBar');
  if(sn) sn.textContent = Math.min(n, 4);
  if(sm && NOMES[n]) sm.textContent = NOMES[n];
  if(pb) pb.setAttribute('aria-valuenow', Math.min(n, 4));

  if(n === 2 && dados.tipo) reativar('btn2');
  if(n === 3 && dados.local) reativar('btn3');
  if(n === 4 && dados.urgencia) reativar('btn3');

  document.getElementById('sistema').scrollIntoView({behavior:'smooth', block:'start'});
}
function reativar(id){
  const b = document.getElementById(id);
  if(b){ b.disabled = false; b.classList.add('ready'); }
}
function avancar(n){ mostrarEtapa(n); }
function voltar(n){ mostrarEtapa(n); }

function ativarOpcoes(seletor, campoDados, btnId){
  document.querySelectorAll(seletor + ' .opt').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll(seletor + ' .opt').forEach(b => {
        b.classList.remove('selected');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('selected');
      btn.setAttribute('aria-pressed', 'true');
      const valor = btn.dataset.tipo || btn.dataset.local || btn.dataset.urg;
      dados[campoDados] = valor;
      const b = document.getElementById(btnId);
      if(b){ b.disabled = false; b.classList.add('ready'); }
    });
  });
}

const PLANOS = {
  arquitetonica:['Vistoria técnica no local em até 48h','Análise de adaptação conforme NBR 9050','Adequação do espaço físico (rampas, corrimãos, sinalização)','Instalação de recursos assistivos necessários','Acompanhamento contínuo com equipe de engenharia'],
  comunicacional:['Implantação de intérprete de Libras quando necessário','Produção de material em Braille','Audiodescrição de conteúdos audiovisuais','Capacitação da equipe em comunicação acessível','Revisão de todos os canais de comunicação interna'],
  tecnologica:['Auditoria de acessibilidade WCAG 2.1','Adaptação do sistema para leitores de tela','Correção de contraste e navegação por teclado','Testes com usuários PCD','Treinamento da equipe de TI em acessibilidade digital'],
  transporte:['Mapeamento de rotas acessíveis','Adequação de veículos para PCD','Capacitação de motoristas','Agendamento via aplicativo acessível','Monitoramento contínuo das rotas'],
  institucional:['Revisão das políticas internas','Alinhamento com a LBI 13.146/2015','Criação de protocolo formal de atendimento','Capacitação de gestores','Implantação de indicadores de inclusão'],
  atitudinal:['Programa de conscientização anticapacitismo','Treinamento obrigatório para todas as lideranças','Canal de denúncia anônimo','Mediação de conflitos com equipe especializada','Acompanhamento psicológico quando necessário']
};
const CATEGORIAS = {arquitetonica:'Arquitetônica',comunicacional:'Comunicacional',tecnologica:'Tecnológica',transporte:'Transporte',institucional:'Institucional',atitudinal:'Atitudinal'};
const LOCAIS = {refinaria:'Refinaria',offshore:'Offshore',escritorio:'Escritório',digital:'Ambiente Digital',rh:'RH'};
const URGENCIAS = {critica:'Crítica',alta:'Alta',media:'Média',baixa:'Baixa'};
const PRAZOS = {critica:'4 horas',alta:'24 horas',media:'72 horas',baixa:'7 dias'};

function processarIA(){
  const nome = document.getElementById('f-nome').value.trim();
  const email = document.getElementById('f-email').value.trim();
  const setor = document.getElementById('f-setor').value.trim();
  const desc = document.getElementById('f-desc').value.trim();
  const sbtn = document.getElementById('sbtn');

  function err(msg){
    sbtn.classList.add('shake');
    setTimeout(() => sbtn.classList.remove('shake'), 400);
    alert('⚠️ ' + msg);
  }

  if(!dados.tipo || !dados.local || !dados.urgencia) return err('Volte e preencha todas as etapas anteriores.');
  if(nome.length < 3) return err('Digite seu nome completo (mínimo 3 letras).');
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return err('Digite um email válido.');
  if(desc.length < 10) return err('Descreva melhor o problema (mínimo 10 caracteres).');

  sbtn.disabled = true;
  sbtn.innerHTML = '<div class="spin"></div> Processando com IA...';

  setTimeout(() => {
    const proto = '#AD-' + Math.floor(Math.random() * 900000 + 100000);
    const plano = PLANOS[dados.tipo] || PLANOS.atitudinal;
    const prazo = PRAZOS[dados.urgencia] || '24 horas';

    document.getElementById('protocolo').textContent = proto;
    document.getElementById('prazo').textContent = prazo;
    document.getElementById('iaBox').innerHTML = `
      <h4>🤖 Plano de Ação gerado pela IA</h4>
      <ul>${plano.map(p => `<li>${p}</li>`).join('')}</ul>
      <div class="tags">
        <span class="tag-r">📌 ${CATEGORIAS[dados.tipo]}</span>
        <span class="tag-r">📍 ${LOCAIS[dados.local]}</span>
        <span class="tag-r">⚡ ${URGENCIAS[dados.urgencia]}</span>
      </div>`;

    mostrarEtapa(5);

    const corpo = `PROTOCOLO: ${proto}

=== DADOS DO SOLICITANTE ===
Nome: ${nome}
Email: ${email}
Setor/Matrícula: ${setor || 'Não informado'}

=== CLASSIFICAÇÃO IA ===
Tipo de barreira: ${CATEGORIAS[dados.tipo]}
Local: ${LOCAIS[dados.local]}
Urgência: ${URGENCIAS[dados.urgencia]}
Prazo: ${prazo}

=== DESCRIÇÃO ===
${desc}

=== PLANO DE AÇÃO GERADO PELA IA ===
${plano.map((p,i) => `${i+1}. ${p}`).join('\n')}

---
Enviado automaticamente pelo Sistema Acessibilidade Digital
Projeto SENAI MT + Petrobras`;

    const assunto = `[Acessibilidade Digital] ${proto} - Barreira ${CATEGORIAS[dados.tipo]}`;
    const mailto = `mailto:felipecosta02838@gmail.com?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;

    try {
      const link = document.createElement('a');
      link.href = mailto;
      link.style.display = 'none';
      document.body.appendChild(link);
      link.click();
      setTimeout(() => link.remove(), 1000);
    } catch(e){
      window.location.href = mailto;
    }

    sbtn.disabled = false;
    sbtn.innerHTML = '🤖 Processar com IA';
  }, 1400);
}

const cb = document.getElementById('cb');
const cbx = document.getElementById('cbx');
const cbd = document.getElementById('cbd');
const ci = document.getElementById('ci');
let chatStarted = false;

function toggleChat(){
  cbx.classList.toggle('open');
  cb.setAttribute('aria-label', cbx.classList.contains('open') ? 'Fechar chat com assistente IA' : 'Abrir chat com assistente IA');
  if(cbx.classList.contains('open') && !chatStarted){
    chatStarted = true;
    botReply('Olá! 👋 Sou o Assistente IA do projeto <b>Acessibilidade Digital</b>. Como posso ajudar?');
  }
}

function addMsg(t, s){
  const d = document.createElement('div');
  d.className = 'msg ' + s;
  d.innerHTML = t;
  cbd.appendChild(d);
  cbd.scrollTop = cbd.scrollHeight;
}
function botReply(t){
  const d = document.createElement('div');
  d.className = 'msg typing';
  d.innerHTML = '<span></span><span></span><span></span>';
  cbd.appendChild(d);
  cbd.scrollTop = cbd.scrollHeight;
  setTimeout(() => { d.remove(); addMsg(t, 'bot'); }, 700);
}
function send(){
  const v = ci.value.trim();
  if(!v) return;
  addMsg(v, 'user');
  ci.value = '';
  ci.blur();
  botReply(resposta(v));
}
function qa(t){ addMsg(t, 'user'); botReply(resposta(t)); }

function resposta(m){
